//@version=6
indicator("Pure Order Block SMC", overlay=true, max_boxes_count=50)

// --- 1. Mendeteksi Fair Value Gap (FVG) ---
// Syarat ledakan harga yang meninggalkan celah kosong
bull_fvg = low > high[2] and close[1] > open[1]
bear_fvg = high < low[2] and close[1] < open[1]

// --- 2. Mengidentifikasi Order Block Murni ---
// Bullish OB = Candle merah (turun) terakhir sebelum FVG ke atas
bull_ob = bull_fvg and close[2] < open[2]

// Bearish OB = Candle hijau (naik) terakhir sebelum FVG ke bawah
bear_ob = bear_fvg and close[2] > open[2]

// --- 3. Menggambar Kotak (Zona Limit Order) ---
if bull_ob
    box.new(left=bar_index[2], top=high[2], right=bar_index + 20, bottom=low[2], border_color=color.new(color.green, 30), border_width=1, bgcolor=color.new(color.green, 85), text="BULL OB", text_color=color.green, text_size=size.small)

if bear_ob
    box.new(left=bar_index[2], top=high[2], right=bar_index + 20, bottom=low[2], border_color=color.new(color.red, 30), border_width=1, bgcolor=color.new(color.red, 85), text="BEAR OB", text_color=color.red, text_size=size.small)

