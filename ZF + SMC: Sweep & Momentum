
//@version=6
strategy("ZF + SMC: Sweep & Momentum", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// --- 1. Parameter SMC & ZF ---
lengthSwing = input.int(5, title="Periode Swing (Likuiditas)")
volMultiplier = input.float(1.5, title="Pengali Momentum Candle")
rr_ratio = input.float(2.0, title="Risk/Reward Ratio (TP)")

// --- 2. Kolam Likuiditas (Swing High/Low) ---
swingHigh = ta.pivothigh(high, lengthSwing, lengthSwing)
swingLow = ta.pivotlow(low, lengthSwing, lengthSwing)

var float lastSwingHigh = na
var float lastSwingLow = na
lastSwingHigh := not na(swingHigh) ? swingHigh : lastSwingHigh
lastSwingLow := not na(swingLow) ? swingLow : lastSwingLow

// --- 3. Logika Liquidity Sweep ---
// Menembus Swing Low tapi tutup di atasnya (Sweep Bawah)
sweepLow = low < lastSwingLow and close > lastSwingLow
// Menembus Swing High tapi tutup di bawahnya (Sweep Atas)
sweepHigh = high > lastSwingHigh and close < lastSwingHigh

// --- 4. Logika Momentum Candle ---
candleBody = math.abs(close - open)
avgBody = ta.sma(candleBody, 14)
momentumBullish = close > open and candleBody > (avgBody * volMultiplier)
momentumBearish = open > close and candleBody > (avgBody * volMultiplier)

// --- 5. Kondisi Eksekusi (Sweep + Momentum) ---
longCond = sweepLow and momentumBullish
shortCond = sweepHigh and momentumBearish

// --- 6. Kalkulasi SL & TP (Otomatis RR 1:2) ---
var float sl_level = na
var float tp_level = na

// SL diletakkan tepat di ujung ekor candle yang melakukan Sweep
sl_level := (longCond and strategy.position_size == 0) ? (low - (syminfo.mintick * 10)) : (shortCond and strategy.position_size == 0) ? (high + (syminfo.mintick * 10)) : sl_level
tp_level := (longCond and strategy.position_size == 0) ? (close + ((close - sl_level) * rr_ratio)) : (shortCond and strategy.position_size == 0) ? (close - ((sl_level - close) * rr_ratio)) : tp_level

if longCond and strategy.position_size == 0
    strategy.entry("SMC_Buy", strategy.long)

if shortCond and strategy.position_size == 0
    strategy.entry("SMC_Sell", strategy.short)

if strategy.position_size > 0
    strategy.exit("Exit_Buy", from_entry="SMC_Buy", stop=sl_level, limit=tp_level)

if strategy.position_size < 0
    strategy.exit("Exit_Sell", from_entry="SMC_Sell", stop=sl_level, limit=tp_level)

// --- 7. Visualisasi Chart ---
plot(lastSwingHigh, color=color.new(color.red, 70), style=plot.style_circles, title="Liquidity High")
plot(lastSwingLow, color=color.new(color.blue, 70), style=plot.style_circles, title="Liquidity Low")

plot(strategy.position_size != 0 ? sl_level : na, color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? tp_level : na, color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)

plotshape(longCond, title="Sweep + Momentum Buy", location=location.belowbar, color=color.blue, style=shape.labelup, text="SMC BUY", textcolor=color.white, size=size.small)
plotshape(shortCond, title="Sweep + Momentum Sell", location=location.abovebar, color=color.red, style=shape.labeldown, text="SMC SELL", textcolor=color.white, size=size.small)
